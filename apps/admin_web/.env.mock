# Loaded by `vite --mode mock` (npm run dev:mock / build:mock).
# The admin API is replaced by src/lib/mock/mockAdminApi.ts and the SPA signs
# itself in with a fake admin token. Cognito values are placeholders that only
# need to be non-empty.
VITE_ADMIN_MOCK=1
VITE_COGNITO_USER_POOL_ID=mock_pool
VITE_COGNITO_CLIENT_ID=mock-client
VITE_COGNITO_DOMAIN=https://mock.auth.example.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_API_BASE_URL=http://mock.local
